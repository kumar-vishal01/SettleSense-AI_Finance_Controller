# SettleSense environment template.
# Copy to .env for local use. NEVER commit a real .env or any real key.

# --- Service (non-secret; see backend/settings.py) ---
SETTLESENSE_ENV=local                     # local | docker | production
SETTLESENSE_TIMEZONE=Asia/Kolkata         # display only; internals are UTC
SETTLESENSE_DB_PATH=settlesense.db        # SQLite file for the MVP
SETTLESENSE_LOG_LEVEL=info
# Comma-separated allowlist; only used by the dev CORS middleware.
SETTLESENSE_CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- AI provider (server-side only; phase 8) ---
# The browser and repo must never contain provider credentials.
# Supported: none (deterministic answers, no key needed) | groq
# Groq keys: https://console.groq.com/keys (OpenAI-compatible endpoint)
SETTLESENSE_AI_PROVIDER=none              # none | groq
SETTLESENSE_AI_API_KEY=                   # paste your gsk_... key here (in .env, not here)
SETTLESENSE_AI_MODEL=llama-3.3-70b-versatile
SETTLESENSE_AI_TIMEOUT_SECONDS=5
SETTLESENSE_AI_DAILY_CALL_CAP=200

# --- Optional Razorpay test-mode adapter (test keys only, never prod) ---
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
